# ===== Microsoft Foundry (add your keys and EXACT deployment names) =====
FOUNDRY_ENDPOINT=
FOUNDRY_API_KEY=
FOUNDRY_API_PATH=/openai/v1
FOUNDRY_FAST_DEPLOYMENT=gpt-6-luna
FOUNDRY_REASONING_DEPLOYMENT=gpt-6-sol
FOUNDRY_TRANSCRIBE_DEPLOYMENT=gpt-transcribe
FOUNDRY_REALTIME_DEPLOYMENT=gpt-realtime-2.1
FOUNDRY_REALTIME_VOICE=marin
FOUNDRY_IMAGE_DEPLOYMENT=
# Only if your region uses different realtime URLs:
FOUNDRY_REALTIME_CLIENT_SECRET_URL=
FOUNDRY_REALTIME_WEBRTC_URL=

# ===== Decision model (Jev / Microsoft-Decision-1): chat | http | heuristic =====
FOUNDRY_DECISION_MODE=chat
FOUNDRY_DECISION_DEPLOYMENT=microsoft-decision-1
FOUNDRY_DECISION_ENDPOINT=
FOUNDRY_DECISION_API_KEY=

# ===== Orchestration: agent_framework (Microsoft Agent Framework, auto-fallback) | builtin =====
ORCHESTRATOR=agent_framework

# ===== Sign-in: demo ("Sign in with Microsoft", simulated, Director by default) | entra =====
AUTH_MODE=demo
ENTRA_TENANT_ID=
ENTRA_API_CLIENT_ID=

# ===== Azure Key Vault (set in Azure; secrets are then loaded by managed identity) =====
KEY_VAULT_URI=

# ===== Optional Azure services =====
CONTENT_SAFETY_ENDPOINT=
CONTENT_SAFETY_KEY=
EVENTHUB_CONNECTION_STRING=
SERVICEBUS_CONNECTION_STRING=
APPLICATIONINSIGHTS_CONNECTION_STRING=

# ===== Governance =====
DAILY_AI_BUDGET_USD=25
RATE_LIMIT_PER_MIN=60
GATE_HIGH_CONFIDENCE=0.85
GATE_LOW_CONFIDENCE=0.60
CORS_ORIGINS=http://localhost:5173,http://localhost:8080
